# Strava credentials for the scraping pipelines.
#
# Copy this file to backend/.env and fill in the values. backend/.gitignore
# excludes *.env, so the real file is never committed.
#
# Strava's API moved behind a paid subscription in June 2026, so these pipelines
# read the logged-in web pages instead of calling the API.
#
# Setup:
#   1. Set STRAVA_ATHLETE_ID below (the number in your profile URL:
#      https://www.strava.com/athletes/<this-number>).
#   2. Optionally set the email and password (see the note below).
#   3. Establish a session once, in a real browser window:
#        cd backend && .venv/bin/python -m hobbies.features.strava.login
#   4. Check what the scrapers can see:
#        .venv/bin/python -m hobbies.features.strava.probe

STRAVA_ATHLETE_ID=10148337

# Optional, and a real trade-off.
#
# With them, an expired session is renewed automatically and scraping never
# needs babysitting. Without them, you re-run the interactive login whenever
# Strava expires the session.
#
# The cost: this is your full-access account password sitting in a local file,
# unlike a scoped API token you could revoke on its own. Keep it on your own
# machine and out of CI. If you sign in with Google, you can add a password
# without removing Google login:
#   https://support.strava.com/en-us/articles/15401899
STRAVA_EMAIL=
STRAVA_PASSWORD=
