# Strava API credentials for the gear pipeline.
#
# Copy this file to backend/.env and fill in the values. backend/.gitignore
# excludes *.env, so the real file is never committed.
#
# Setup:
#   1. Create an API application at https://www.strava.com/settings/api
#      Set "Authorization Callback Domain" to: localhost
#   2. Copy the Client ID and Client Secret below.
#   3. Run the one-time authorization to get a refresh token:
#        cd backend && .venv/bin/python -m hobbies.features.gear.authorize
#   4. Paste the refresh token it prints below.

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Long-lived. Access tokens are minted from this on every run, so this is the
# only Strava secret that needs storing. If Strava ever rotates it, the pipeline
# prints a warning with the replacement value.
STRAVA_REFRESH_TOKEN=
